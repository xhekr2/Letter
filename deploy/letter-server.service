# /etc/systemd/system/letter-server.service
# 사용 전: sudo useradd --system --no-create-home letter
#          sudo mkdir -p /opt/letter
#          sudo javac -encoding UTF-8 -d /opt/letter $(find src -name '*.java')
[Unit]
Description=Letter Server
After=network.target

[Service]
User=letter
WorkingDirectory=/opt/letter
Environment=PORT=10000
Environment=DATA_DIR=/var/lib/letter
Environment=RATE_LIMIT_PER_MIN=600
# 디스코드 전송 기능: 봇 토큰은 이 서비스 파일이 아니라 별도 파일에 둔다. (파일이 없으면 기능이 꺼진다)
#   sudo mkdir -p /etc/letter
#   sudo install -m 600 -o root -g root /dev/null /etc/letter/discord.env
#   sudo sh -c 'echo DISCORD_BOT_TOKEN=여기에_봇_토큰 > /etc/letter/discord.env'
EnvironmentFile=-/etc/letter/discord.env
ExecStart=/usr/bin/java -cp /opt/letter letter.server.LetterServer
Restart=on-failure
RestartSec=3
# /var/lib/letter 를 만들어 주고 letter 사용자가 쓸 수 있게 한다
StateDirectory=letter
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
